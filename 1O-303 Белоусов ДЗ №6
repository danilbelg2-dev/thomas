import numpy as np

# Функции системы
def f1 ( x, y ) :
    return (x**2 + 16) * y - 64

def f2 ( x, y ) :
    return (x - 2 ) **2 + (y - 2 ) **2 - 16

# Вектор функций
def F ( x, y ) :
    return np.array ( [f1 ( x, y ) , f2 ( x, y ) ], dtype=float)

# Матрица Якоби (определил производные на  листике : ) )
def jacobian ( x, y ) :
    return np.array ( [
        [2 * x * y, x**2 + 16],
        [2 * (x - 2 ) , 2 * (y - 2 ) ]
    ], dtype=float)

eps = 0.001
x = 6  # графическое приближение определил в десмосе и специально занизил точность для проверки работы алгоритма
y = 1
iter_count = 0

print ( "Метод Ньютона для системы:")
while True:
    # Вычисляем F и J в текущей точке
    F_val = F ( x, y)
    J_val = jacobian ( x, y)
    
    # Решаем систему J * delta ( х ) = -F
    delta = np.linalg.solve ( J_val, -F_val)
    
    # Определяем новые значения   х, у
    x_old, y_old = x, y
    x = x + delta[0]
    y = y + delta[1]
    
    iter_count += 1
    diff = max ( abs ( x - x_old ) , abs ( y - y_old ) ) #  Определяем delta ( x ) )
    
    print ( f"Итерация {iter_count}: x = {x:.5f}, y = {y:.5f}, погрешность = {diff:.6f}")
    
    if diff < eps:
        break

print ( f"\n Ответ: x = {x:.5f}, y = {y:.5f}, итераций: {iter_count}")

exit ()
